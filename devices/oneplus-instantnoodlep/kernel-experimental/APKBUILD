# Experimental Omnipha kernel; no device/firmware payload, not production-ready.
# Public sm8250 tag + display and device patch series; not yet hardware tested.
_flavor="omnipha-qcom-sm8250"
pkgname="linux-$_flavor"
pkgver=7.2.0_git20261107
pkgrel=1
pkgdesc="Experimental SM8250 kernel based on the mb005 build"
url="https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux"
arch="aarch64"
_carch="arm64"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	python3
"
_commit="3c5440e9dd3c3e3b5735ad8f1b22bdfd02c707d9"
_config="config-$_flavor.$arch"
# Public commit archive corresponds to tag sm8250-7.2.0_git20261010.
source="
	https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux/-/archive/$_commit/linux-$_commit.tar.gz
	0001-display-bindings.patch
	0002-display-panel.patch
	0003-display-dts.patch
	0004-audio.patch
	0005-camera-drivers.patch
	0006-camera-dts.patch
	0007-gpu-fastboot.patch
	$_config
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	export KBUILD_BUILD_USER=omnipha KBUILD_BUILD_HOST=build
	export KBUILD_BUILD_TIMESTAMP="Sat Nov  7 18:10:03 UTC 2026"
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	if [ -e "$builddir/arch/$_carch/boot/vmlinuz.efi" ]; then
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" "$pkgdir/boot/linux.efi"
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" "$pkgdir/boot/vmlinuz"
	else
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" "$pkgdir/boot/vmlinuz"
	fi
	make modules_install dtbs_install ARCH="$_carch" LLVM=1 \
		INSTALL_PATH="$pkgdir/boot" \
		INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}
