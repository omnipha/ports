	pmu {
		interrupts = <0x01 0x07 0x08>;
		compatible = "arm,armv8-pmuv3";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@300 {
			power-domains = <0x11>;
			capacity-dmips-mhz = <0x1c0>;
			interconnects = <0x08 0x02 0x00 0x09 0x01 0x00 0x0a 0x00 0x0a 0x01>;
