			compatible = "qcom,kryo485";
			dynamic-power-coefficient = <0x69>;
			next-level-cache = <0x10>;
			reg = <0x00 0x300>;
			enable-method = "psci";
			phandle = <0x1f>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;

			l2-cache {
				cache-size = <0x20000>;
				cache-level = <0x02>;
				cache-unified;
				compatible = "cache";
				next-level-cache = <0x0b>;
				phandle = <0x10>;
			};
		};

