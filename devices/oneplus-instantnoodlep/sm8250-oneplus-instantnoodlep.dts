/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "OnePlus 8 Pro";
	qcom,board-id = <0x08 0x00 0x00 0x00>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "oneplus,instantnoodlep", "qcom,sm8250";
	qcom,msm-id = <0x164 0x10000 0x164 0x20001>;
	chassis-type = "handset";

	opp-table-cpu7 {
		opp-shared;
		compatible = "operating-points-v2";
		phandle = <0x1b>;

		opp-1632000000 {
			opp-peak-kBps = <0x5294a0 0x2580000>;
			opp-hz = <0x00 0x61465800>;
		};

		opp-2265600000 {
			opp-peak-kBps = <0x6e1b80 0x3138000>;
			opp-hz = <0x00 0x870a5000>;
		};

		opp-844800000 {
			opp-peak-kBps = <0x2162e0 0x12c0000>;
			opp-hz = <0x00 0x325aa000>;
		};

		opp-1305600000 {
			opp-peak-kBps = <0x3e12a0 0x1f0e000>;
			opp-hz = <0x00 0x4dd1e000>;
		};

		opp-2553600000 {
			opp-peak-kBps = <0x7faf80 0x3138000>;
			opp-hz = <0x00 0x9834d800>;
		};

		opp-2841600000 {
			opp-peak-kBps = <0x7faf80 0x3138000>;
			opp-hz = <0x00 0xa95f6000>;
		};

		opp-1516800000 {
			opp-peak-kBps = <0x3e12a0 0x2292000>;
			opp-hz = <0x00 0x5a688800>;
		};

		opp-2649600000 {
			opp-peak-kBps = <0x7faf80 0x3138000>;
			opp-hz = <0x00 0x9dedb000>;
		};

		opp-1190400000 {
			opp-peak-kBps = <0x2ee000 0x1c20000>;
			opp-hz = <0x00 0x46f41000>;
		};

		opp-1075200000 {
			opp-peak-kBps = <0x2ee000 0x1932000>;
			opp-hz = <0x00 0x40164000>;
		};

		opp-1977600000 {
			opp-peak-kBps = <0x5ee8e0 0x2e4a000>;
			opp-hz = <0x00 0x75dfc800>;
		};

		opp-2073600000 {
			opp-peak-kBps = <0x6e1b80 0x2e4a000>;
			opp-hz = <0x00 0x7b98a000>;
		};

		opp-2361600000 {
			opp-peak-kBps = <0x7faf80 0x3138000>;
			opp-hz = <0x00 0x8cc32800>;
		};

		opp-1401600000 {
			opp-peak-kBps = <0x3e12a0 0x1f0e000>;
			opp-hz = <0x00 0x538ab800>;
		};

		opp-2169600000 {
			opp-peak-kBps = <0x6e1b80 0x3138000>;
			opp-hz = <0x00 0x81517800>;
		};

		opp-2457600000 {
			opp-peak-kBps = <0x7faf80 0x3138000>;
			opp-hz = <0x00 0x927c0000>;
		};

		opp-1862400000 {
			opp-peak-kBps = <0x5ee8e0 0x2b5c000>;
			opp-hz = <0x00 0x6f01f800>;
		};

		opp-1747200000 {
			opp-peak-kBps = <0x5294a0 0x286e000>;
			opp-hz = <0x00 0x68242800>;
		};

		opp-2745600000 {
			opp-peak-kBps = <0x7faf80 0x3138000>;
			opp-hz = <0x00 0xa3a68800>;
		};

		opp-3091200000 {
			opp-peak-kBps = <0x7faf80 0x3138000>;
			opp-hz = <0x00 0xb83ff800>;
		};

		opp-960000000 {
			opp-peak-kBps = <0x2162e0 0x1932000>;
			opp-hz = <0x00 0x39387000>;
		};
	};

	soc@0 {
		dma-ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x00 0x10 0x00>;

		thermal-sensor@c265000 {
			#qcom,sensors = <0x09>;
			interrupts = <0x00 0x1fb 0x04 0x00 0x1fd 0x04>;
			#thermal-sensor-cells = <0x01>;
			compatible = "qcom,sm8250-tsens", "qcom,tsens-v2";
			interrupt-names = "uplow", "critical";
			reg = <0x00 0xc265000 0x00 0x1ff 0x00 0xc223000 0x00 0x1ff>;
			phandle = <0x127>;
		};

		phy@1c16000 {
			clock-output-names = "pcie_2_pipe_clk";
			clock-names = "aux", "cfg_ahb", "ref", "refgen", "pipe";
			assigned-clocks = <0x03 0x30>;
			assigned-clock-rates = <0x5f5e100>;
			resets = <0x03 0x11>;
			clocks = <0x03 0x47 0x03 0x41 0x03 0x46 0x03 0x30 0x03 0x43>;
			#clock-cells = <0x00>;
			vdda-phy-supply = <0x68>;
			#phy-cells = <0x00>;
			vdda-pll-supply = <0x69>;
			compatible = "qcom,sm8250-qmp-modem-pcie-phy";
			status = "okay";
			reg = <0x00 0x1c16000 0x00 0x1000>;
			phandle = <0x6c>;
			reset-names = "phy";
		};

		etm@7640000 {
			clock-names = "apb_pclk";
			clocks = <0x8d>;
			arm,coresight-loses-context-with-cpu;
			cpu = <0x22>;
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x00 0x7640000 0x00 0x1000>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xb3>;
						phandle = <0xbc>;
					};
				};
			};
		};

		interrupt-controller@17a00000 {
			#address-cells = <0x00>;
			interrupts = <0x01 0x09 0x04>;
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			reg = <0x00 0x17a00000 0x00 0x10000 0x00 0x17a60000 0x00 0x100000>;
			phandle = <0x01>;
			interrupt-controller;
		};

		pmu@90b6400 {
			interconnects = <0x08 0x02 0x03 0x08 0x0c 0x03>;
			interrupts = <0x00 0x245 0x04>;
			compatible = "qcom,sm8250-cpu-bwmon", "qcom,sdm845-bwmon";
			reg = <0x00 0x90b6400 0x00 0x600>;
			operating-points-v2 = <0xca>;

			opp-table {
				compatible = "operating-points-v2";
				phandle = <0xca>;

				opp-1804000 {
					opp-peak-kBps = <0x1b86e0>;
				};

				opp-800000 {
					opp-peak-kBps = "", "\f5";
				};

				opp-2188000 {
					opp-peak-kBps = <0x2162e0>;
				};

				opp-6220000 {
					opp-peak-kBps = <0x5ee8e0>;
				};

				opp-12784000 {
					opp-peak-kBps = <0xc31180>;
				};

				opp-3072000 {
					opp-peak-kBps = <0x2ee000>;
				};

				opp-10944000 {
					opp-peak-kBps = <0xa6fe00>;
				};

				opp-6832000 {
					opp-peak-kBps = <0x683f80>;
				};

				opp-8368000 {
					opp-peak-kBps = <0x7faf80>;
				};

				opp-2724000 {
					opp-peak-kBps = <0x2990a0>;
				};
			};
		};

		tpdm@684c000 {
			clock-names = "apb_pclk";
			clocks = <0x8d>;
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x684c000 0x00 0x1000>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xa1>;
						phandle = <0x93>;
					};
				};
			};
		};

		sram@c3f0000 {
			compatible = "qcom,rpmh-stats";
			reg = <0x00 0xc3f0000 0x00 0x400>;
		};

		rsc@18200000 {
			power-domains = <0x26>;
			reg-names = "drv-0", "drv-1", "drv-2";
			interrupts = <0x00 0x03 0x04 0x00 0x04 0x04 0x00 0x05 0x04>;
			label = "apps_rsc";
			qcom,drv-id = <0x02>;
			compatible = "qcom,rpmh-rsc";
			qcom,tcs-offset = <0xd00>;
			reg = <0x00 0x18200000 0x00 0x10000 0x00 0x18210000 0x00 0x10000 0x00 0x18220000 0x00 0x10000>;
			qcom,tcs-config = <0x02 0x02 0x00 0x03 0x01 0x03 0x03 0x01>;

			clock-controller {
				clock-names = "xo";
				clocks = <0xfb>;
				#clock-cells = <0x01>;
				compatible = "qcom,sm8250-rpmh-clk";
				phandle = <0x30>;
			};

			regulators-2 {
				vdd-l9-l10-supply = <0x7d>;
				vdd-s1-supply = <0xfd>;
				vdd-s2-supply = <0xfd>;
				vdd-l1-l8-supply = <0x3c>;
				vdd-s3-supply = <0xfd>;
				vdd-l7-l11-supply = <0x7d>;
				vdd-s4-supply = <0xfd>;
				vdd-s5-supply = <0xfd>;
				vdd-l2-l3-supply = <0xfe>;
				vdd-s6-supply = <0xfd>;
				vdd-s7-supply = <0xfd>;
				vdd-s8-supply = <0xfd>;
				compatible = "qcom,pm8150l-rpmh-regulators";
				qcom,pmic-id = "c";
				vdd-bob-supply = <0xfd>;
				vdd-l4-l5-l6-supply = <0x7d>;

				smps8 {
					regulator-max-microvolt = <0x14a140>;
					regulator-min-microvolt = <0x14a140>;
					regulator-name = "vreg_s8c_1p3";
					regulator-initial-mode = <0x03>;
					phandle = <0xfe>;
				};

				ldo8 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l8c_1p8";
					regulator-initial-mode = <0x03>;
				};

				ldo6 {
					regulator-max-microvolt = <0x2d2a80>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l6c_2p96";
					regulator-initial-mode = <0x03>;
				};

				bob {
					regulator-max-microvolt = "", "=\t";
					regulator-min-microvolt = <0x2de600>;
					regulator-name = "vreg_bob";
					regulator-initial-mode = <0x02>;
					phandle = <0x7d>;
				};

				ldo10 {
					regulator-max-microvolt = <0x2dc6c0>;
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-name = "vreg_l10c_3p0";
					regulator-initial-mode = <0x03>;
				};

				ldo4 {
					regulator-max-microvolt = <0x2cad80>;
					regulator-min-microvolt = <0x1a0040>;
					regulator-name = "vreg_l4c_1p7";
					regulator-initial-mode = <0x03>;
				};

				ldo2 {
					regulator-max-microvolt = <0x124f80>;
					regulator-min-microvolt = <0x124f80>;
					regulator-name = "vreg_l2c_1p2";
					regulator-initial-mode = <0x03>;
				};

				ldo9 {
					regulator-max-microvolt = <0x2d2a80>;
					regulator-min-microvolt = <0x294280>;
					regulator-name = "vreg_l9c_2p96";
					regulator-initial-mode = <0x03>;
				};

				ldo7 {
					regulator-max-microvolt = "", "/]";
					regulator-min-microvolt = <0x2b9440>;
					regulator-name = "vreg_l7c_cam_vcm0_2p85";
					regulator-initial-mode = <0x03>;
					phandle = <0x160>;
				};

				ldo11 {
					regulator-max-microvolt = "", "2K";
					regulator-always-on;
					regulator-min-microvolt = "", "2K";
					regulator-name = "vreg_l11c_3p3";
					regulator-initial-mode = <0x03>;
					phandle = <0xe7>;
				};

				ldo5 {
					regulator-max-microvolt = <0x2cad80>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l5c_1p8";
					regulator-initial-mode = <0x03>;
				};

				ldo3 {
					regulator-max-microvolt = "", "\f5";
					regulator-min-microvolt = "", "\f5";
					regulator-name = "vreg_l3c_0p8";
					regulator-initial-mode = <0x03>;
				};

				ldo1 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l1c_1p8";
					regulator-initial-mode = <0x03>;
					phandle = <0x5f>;
				};
			};

			regulators-0 {
				vdd-s1-supply = <0xfd>;
				vdd-s2-supply = <0xfd>;
				compatible = "qcom,pm8009-1-rpmh-regulators";
				qcom,pmic-id = "f";
				vdd-l2-supply = <0xfe>;
				vdd-l5-l6-supply = <0x7d>;
				vdd-l7-supply = <0x3c>;

				ldo6 {
					regulator-max-microvolt = <0x2ab980>;
					regulator-min-microvolt = <0x2ab980>;
					regulator-name = "vreg_l6f_2p8";
					regulator-initial-mode = <0x03>;
					phandle = <0x15e>;
				};

				ldo4 {
					regulator-max-microvolt = <0x101d00>;
					regulator-min-microvolt = <0x101d00>;
					regulator-name = "vreg_l4f_1p05";
					regulator-initial-mode = <0x03>;
					phandle = <0x158>;
				};

				smps2 {
					regulator-max-microvolt = <0xe86c0>;
					regulator-min-microvolt = <0xdbba0>;
					regulator-name = "vreg_s2f_0p95";
					regulator-initial-mode = <0x02>;
					phandle = <0x12e>;
				};

				ldo2 {
					regulator-max-microvolt = <0x10d880>;
					regulator-min-microvolt = <0x10d880>;
					regulator-name = "vreg_l2f_1p1";
					regulator-initial-mode = <0x03>;
					phandle = <0x15d>;
				};

				ldo7 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l7f_1p8";
					regulator-initial-mode = <0x03>;
					phandle = <0x15f>;
				};

				ldo3 {
					regulator-max-microvolt = <0x101d00>;
					regulator-min-microvolt = <0x101d00>;
					regulator-name = "vreg_l3f_1p05";
					regulator-initial-mode = <0x03>;
					phandle = <0x157>;
				};

				ldo1 {
					regulator-max-microvolt = <0x10d880>;
					regulator-min-microvolt = <0x10d880>;
					regulator-name = "vreg_l1f_1p1";
					regulator-initial-mode = <0x03>;
					phandle = <0x15c>;
				};
			};

			bcm-voter {
				compatible = "qcom,bcm-voter";
				phandle = <0x24>;
			};

			power-controller {
				#power-domain-cells = <0x01>;
				compatible = "qcom,sm8250-rpmhpd";
				phandle = <0x35>;
				operating-points-v2 = <0xfc>;

				opp-table {
					compatible = "operating-points-v2";
					phandle = <0xfc>;

					opp9 {
						opp-level = <0x180>;
					};

					opp7 {
						opp-level = <0x140>;
					};

					opp10 {
						opp-level = <0x1a0>;
					};

					opp5 {
						opp-level = <0xc0>;
						phandle = <0xc8>;
					};

					opp3 {
						opp-level = <0x40>;
						phandle = <0x2b>;
					};

					opp1 {
						opp-level = <0x10>;
					};

					opp8 {
						opp-level = <0x150>;
					};

					opp6 {
						opp-level = <0x100>;
						phandle = <0x72>;
					};

					opp4 {
						opp-level = <0x80>;
						phandle = <0x2c>;
					};

					opp2 {
						opp-level = <0x30>;
						phandle = <0x2a>;
					};
				};
			};

			regulators-1 {
				vdd-s1-supply = <0xfd>;
				vdd-s2-supply = <0xfd>;
				vdd-l2-l10-supply = <0x7d>;
				vdd-s3-supply = <0xfd>;
				vdd-l6-l9-supply = <0xfe>;
				vdd-s4-supply = <0xfd>;
				vdd-s5-supply = <0xfd>;
				vdd-s6-supply = <0xfd>;
				vdd-s7-supply = <0xfd>;
				vdd-s8-supply = <0xfd>;
				vdd-s9-supply = <0xfd>;
				vdd-l13-l16-l17-supply = <0x7d>;
				compatible = "qcom,pm8150-rpmh-regulators";
				qcom,pmic-id = "a";
				vdd-s10-supply = <0xfd>;
				vdd-l7-l12-l14-l15-supply = <0x100>;
				vdd-l3-l4-l5-l18-supply = <0xff>;

				ldo16 {
					regulator-max-microvolt = <0x2d2a80>;
					regulator-min-microvolt = <0x294280>;
					regulator-name = "vreg_l16a_2p7";
					regulator-initial-mode = <0x03>;
				};

				ldo14 {
					regulator-max-microvolt = <0x1cafc0>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l14a_1p8";
					regulator-initial-mode = <0x03>;
					phandle = <0xe6>;
				};

				smps6 {
					regulator-max-microvolt = <0x113640>;
					regulator-min-microvolt = <0xe09c0>;
					regulator-name = "vreg_s6a_0p95";
					regulator-initial-mode = <0x03>;
					phandle = <0xff>;
				};

				ldo12 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l12a_1p8";
					regulator-initial-mode = <0x03>;
					phandle = <0xc3>;
				};

				ldo6 {
					regulator-max-microvolt = <0x124f80>;
					regulator-min-microvolt = <0x124f80>;
					regulator-name = "vreg_l6a_1p2";
					regulator-initial-mode = <0x03>;
					phandle = <0x71>;
				};

				ldo10 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l10a_1p8";
					regulator-initial-mode = <0x03>;
				};

				ldo2 {
					regulator-max-microvolt = <0x2ee000>;
					regulator-min-microvolt = <0x2ee000>;
					regulator-name = "vreg_l2a_3p1";
					regulator-initial-mode = <0x03>;
					phandle = <0xc4>;
				};

				ldo17 {
					regulator-max-microvolt = <0x2de600>;
					regulator-min-microvolt = <0x2b9440>;
					regulator-name = "vreg_l17a_3p0";
					regulator-initial-mode = <0x03>;
					phandle = <0x70>;
				};

				ldo15 {
					regulator-max-microvolt = <0x1b7740>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-name = "vreg_l15a_1p8";
					regulator-initial-mode = <0x03>;
				};

				ldo9 {
