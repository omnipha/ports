			compatible = "qcom,kryo485";
			dynamic-power-coefficient = <0x1bc>;
			next-level-cache = <0x19>;
			reg = <0x00 0x700>;
			enable-method = "psci";
			phandle = <0x23>;
			operating-points-v2 = <0x1b>;
			#cooling-cells = <0x02>;

			l2-cache {
				cache-size = <0x80000>;
				cache-level = <0x02>;
				cache-unified;
				compatible = "cache";
				next-level-cache = <0x0b>;
				phandle = <0x19>;
			};
		};
	};

	regulator-cam-tele-vaf {
		regulator-max-microvolt = <0x2ab980>;
		pinctrl-names = "default";
		gpio = <0x3b 0x8c 0x00>;
		pinctrl-0 = <0x154>;
		enable-active-high;
		regulator-min-microvolt = <0x2ab980>;
		regulator-name = "cam_tele_vaf";
		startup-delay-us = <0x7d0>;
		compatible = "regulator-fixed";
		phandle = <0x13a>;
		vin-supply = <0x7d>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@80900000 {
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0x2d>;
			no-map;
		};

		ramoops@b0000000 {
			ecc-size = <0x00>;
			record-size = <0x40000>;
			compatible = "ramoops";
			console-size = <0x40000>;
			reg = <0x00 0xb0000000 0x00 0x400000>;
			no-map;
		};

		memory@80b00000 {
