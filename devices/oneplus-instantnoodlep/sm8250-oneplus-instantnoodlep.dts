	regulator-cam-uw-avdd2 {
		regulator-max-microvolt = <0x1b7740>;
		pinctrl-names = "default";
		gpio = <0x3b 0x9f 0x00>;
		pinctrl-0 = <0x155>;
		enable-active-high;
		regulator-min-microvolt = <0x1b7740>;
		regulator-name = "cam_uw_avdd2";
		startup-delay-us = <0x7d0>;
		compatible = "regulator-fixed";
		phandle = <0x13c>;
		vin-supply = <0x100>;
	};

	firmware {

