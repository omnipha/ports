		};

		codec@3370000 {
			pinctrl-names = "default", "sleep";
			clock-output-names = "fsgen";
			pinctrl-0 = <0x79 0x7a>;
			clock-names = "mclk", "macro", "dcodec";
			clocks = <0x75 0x39 0x01 0x75 0x66 0x01 0x75 0x67 0x01>;
			qcom,dmic-sample-rate = <0x249f00>;
