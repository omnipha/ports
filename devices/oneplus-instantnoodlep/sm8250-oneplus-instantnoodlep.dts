		};

		memory@94100000 {
			reg = <0x00 0x94100000 0x00 0x4600000>;
			no-map;
		};

		fastrpc {
			alignment = <0x400000>;
			alloc-ranges = <0x80000000 0x78000000>;
			compatible = "shared-dma-pool";
			phandle = <0x8f>;
			reusable;
		};

		memory@8e21a000 {
			reg = <0x00 0x8e21a000 0x00 0x2000>;
			phandle = <0x87>;
			no-map;
		};

		memory@91b00000 {
			reg = <0x00 0x91b00000 0x00 0x2500000>;
			phandle = <0xf9>;
			no-map;
		};

		memory@9c000000 {
			reg = <0x00 0x9c000000 0x00 0x2300000>;
			no-map;
		};

		memory@8e300000 {
			reg = <0x00 0x8e300000 0x00 0x500000>;
			no-map;
		};

		memory@90600000 {
			reg = <0x00 0x90600000 0x00 0x1500000>;
			phandle = <0x8c>;
			no-map;
		};

		memory@94000000 {
			reg = <0x00 0x94000000 0x00 0x100000>;
			no-map;
		};

		memory@8e200000 {
			reg = <0x00 0x8e200000 0x00 0x10000>;
			no-map;
		};

		memory@80860000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x80860000 0x00 0x20000>;
			no-map;
		};

		memory@8e800000 {
			reg = <0x00 0x8e800000 0x00 0x500000>;
			phandle = <0xd4>;
			no-map;
		};

		memory@8e100000 {
			reg = <0x00 0x8e100000 0x00 0x100000>;
			no-map;
		};

		memory@8e210000 {
			reg = <0x00 0x8e210000 0x00 0xa000>;
			no-map;
		};

		memory@8f200000 {
			reg = <0x00 0x8f200000 0x00 0x1400000>;
			phandle = <0xc1>;
			no-map;
		};
	};

	interconnect-qup-virt {
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x24>;
		compatible = "qcom,sm8250-qup-virt";
		phandle = <0x36>;
