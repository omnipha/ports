	chosen {
		#address-cells = <0x02>;
		bootargs = "quiet";
		#size-cells = <0x02>;
		ranges;
		stdout-path = "framebuffer0";

		framebuffer@9c000000 {
			power-domains = <0x02 0x00>;
			format = "a8r8g8b8";
			height = <0x948>;
			width = <0x438>;
			clocks = <0x02 0x00 0x03 0x18 0x03 0x19 0x02 0x2c 0x02 0x20 0x02 0x02 0x02 0x05 0x02 0x24 0x02 0x1c>;
			stride = <0x10e0>;
			compatible = "simple-framebuffer";
			reg = <0x00 0x9c000000 0x00 0x9c9f00>;
		};
	};

