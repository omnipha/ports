	clocks {

		xo-board {
			clock-output-names = "xo_board";
			#clock-cells = <0x00>;
			clock-frequency = <0x249f000>;
			compatible = "fixed-clock";
			phandle = <0xfb>;
		};

		sleep-clk {
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			compatible = "fixed-clock";
			phandle = <0x31>;
		};
	};

	psci {
		method = "smc";
		compatible = "arm,psci-1.0";

		power-domain-cpu6 {
			power-domains = <0x26>;
			domain-idle-states = <0x28>;
			#power-domain-cells = <0x00>;
			phandle = <0x18>;
		};

		power-domain-cpu4 {
			power-domains = <0x26>;
			domain-idle-states = <0x28>;
			#power-domain-cells = <0x00>;
			phandle = <0x13>;
		};

		power-domain-cpu2 {
			power-domains = <0x26>;
			domain-idle-states = <0x27>;
			#power-domain-cells = <0x00>;
			phandle = <0x0f>;
		};

		power-domain-cpu0 {
			power-domains = <0x26>;
			domain-idle-states = <0x27>;
			#power-domain-cells = <0x00>;
			phandle = <0x06>;
		};

		power-domain-cpu7 {
			power-domains = <0x26>;
			domain-idle-states = <0x28>;
			#power-domain-cells = <0x00>;
			phandle = <0x1a>;
		};

		power-domain-cpu-cluster0 {
			domain-idle-states = <0x29>;
			#power-domain-cells = <0x00>;
			phandle = <0x26>;
		};

		power-domain-cpu5 {
			power-domains = <0x26>;
			domain-idle-states = <0x28>;
			#power-domain-cells = <0x00>;
			phandle = <0x16>;
		};

		power-domain-cpu3 {
			power-domains = <0x26>;
			domain-idle-states = <0x27>;
			#power-domain-cells = <0x00>;
			phandle = <0x11>;
		};

		power-domain-cpu1 {
			power-domains = <0x26>;
			domain-idle-states = <0x27>;
			#power-domain-cells = <0x00>;
			phandle = <0x0d>;
		};
	};

	memory@80000000 {
		ddr_device_type = <0x08>;
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x39900000 0x02 0x00 0x01 0x80000000 0x00 0xc0000000 0x01 0x40000000>;
	};

	regulator-cam-front-avdd {
		regulator-max-microvolt = <0x2ab980>;
		pinctrl-names = "default";
		gpio = <0x3b 0x18 0x00>;
		pinctrl-0 = <0x14c>;
		enable-active-high;
		regulator-min-microvolt = <0x2ab980>;
		regulator-name = "cam_front_avdd";
		startup-delay-us = <0x7d0>;
		compatible = "regulator-fixed";
		phandle = <0x135>;
		vin-supply = <0x7d>;
	};

	smpc6-regulator {
		regulator-max-microvolt = <0xd6d80>;
		regulator-always-on;
		regulator-min-microvolt = <0xd6d80>;
		regulator-name = "vreg_s6c_0p88";
		compatible = "regulator-fixed";
		vin-supply = <0xfd>;
	};

	vph-pwr-regulator {
		regulator-max-microvolt = <0x387520>;
		regulator-min-microvolt = <0x387520>;
		regulator-name = "vph_pwr";
		compatible = "regulator-fixed";
		phandle = <0xfd>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		vol-down {
			linux,can-disable;
			label = "Volume Down";
			gpio-key,wakeup;
			linux,code = <0x72>;
			debounce-interval = <0x0f>;
			gpios = <0xf1 0x07 0x01>;
		};

		vol-up {
			linux,can-disable;
			label = "Volume Up";
			gpio-key,wakeup;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
			gpios = <0xf1 0x06 0x01>;
		};
	};

	timer {
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
		compatible = "arm,armv8-timer";
	};

	smp2p-adsp {
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;
		interrupts-extended = <0x2f 0x03 0x02 0x01>;
		compatible = "qcom,smp2p";
		mboxes = <0x2f 0x03 0x02>;
		qcom,smem = <0x1bb 0x1ad>;

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			#interrupt-cells = <0x02>;
			phandle = <0xf8>;
			interrupt-controller;
		};

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xfa>;
		};
	};

