				};

				ldo13 {
					regulator-max-microvolt = <0x2de600>;
					regulator-min-microvolt = <0x2de600>;
					regulator-name = "vreg_l13a_ts_3p0";
					regulator-initial-mode = <0x03>;
					phandle = <0x5e>;
				};

				ldo7 {
