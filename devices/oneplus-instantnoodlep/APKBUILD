# Reference: <https://postmarketos.org/devicepkg>
maintainer="kouling <k0ul1ng@proton.me>"
pkgname=device-oneplus-instantnoodlep
pkgdesc="OnePlus 8 Pro"
pkgver=8
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bootmac
	bootmac-systemd
	linux-postmarketos-qcom-sm8250=7.2.0_git20261010-r0
	mkbootimg
	postmarketos-base
	qcam
	soc-qcom-qbootctl
"
makedepends="
	devicepkg-dev
	dtc
"
source="
	99-oneplus-instantnoodlep.rules
	bq25980-blacklist.conf
	deviceinfo
	kernel-cmdline.conf
	qcam.desktop
	sm8250-oneplus-instantnoodlep-empty.dts
	sm8250-oneplus-instantnoodlep.dts
"

build() {
	devicepkg_build $startdir $pkgname

	dtc -O dtb -o "$srcdir/dtbo.img" -I dts "$srcdir/sm8250-oneplus-instantnoodlep-empty.dts"
	dtc -O dtb -o "$srcdir/sm8250-oneplus-instantnoodlep.dtb" -I dts "$srcdir/sm8250-oneplus-instantnoodlep.dts"
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
	install -Dm644 "$srcdir/sm8250-oneplus-instantnoodlep.dtb" "$pkgdir/boot/sm8250-oneplus-instantnoodlep.dtb"
	install -Dm644 "$srcdir/bq25980-blacklist.conf" "$pkgdir/etc/modprobe.d/bq25980-blacklist.conf"
	install -Dm644 "$srcdir/99-oneplus-instantnoodlep.rules" "$pkgdir/lib/udev/rules.d/99-oneplus-instantnoodlep.rules"
	install -Dm644 "$srcdir/qcam.desktop" "$pkgdir/usr/share/applications/qcam.desktop"
}

