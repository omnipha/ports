maintainer="kouling <k0ul1ng@proton.me>"
pkgname=device-oneplus-instantnoodlep
pkgdesc="OnePlus 8 Pro"
pkgver=7
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8250=7.2.0_git20261010-r0
	mkbootimg
	postmarketos-base
"
makedepends="
	devicepkg-dev
	dtc
"
source="
	deviceinfo
	kernel-cmdline.conf
	sm8250-oneplus-instantnoodlep-empty.dts
"

build() {
	devicepkg_build $startdir $pkgname

	dtc -O dtb -o "$srcdir/dtbo.img" -I dts "$srcdir/sm8250-oneplus-instantnoodlep-empty.dts"
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
}

