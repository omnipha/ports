# Reference: <https://postmarketos.org/devicepkg>
maintainer="kouling <k0ul1ng@proton.me>"
pkgname=device-oneplus-instantnoodlep
pkgdesc="OnePlus 8 Pro"
pkgver=8
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	bootmac
	bootmac-systemd
	linux-postmarketos-qcom-sm8250=7.2.0_git20261010-r0
	mkbootimg
	postmarketos-base
	qcam
	soc-qcom-qbootctl
"
makedepends="
	devicepkg-dev
	dtc
"
install="$pkgname.post-install"
source="
	80-battery-ignore-charger.rules
	OnePlus8Pro-HiFi.conf
	OnePlus8Pro.conf
	bq25980-blacklist.conf
	deviceinfo
	disable-bq25980.service
	kernel-cmdline.conf
	qcam.desktop
	sm8250-oneplus-instantnoodlep-empty.dts
"

build() {
	devicepkg_build $startdir $pkgname
	dtc -O dtb -o "$srcdir/dtbo.img" -I dts "$srcdir/sm8250-oneplus-instantnoodlep-empty.dts"
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
	install -Dm644 "$srcdir/bq25980-blacklist.conf" "$pkgdir/etc/modprobe.d/bq25980-blacklist.conf"
	install -Dm644 "$srcdir/80-battery-ignore-charger.rules" "$pkgdir/usr/lib/udev/rules.d/80-battery-ignore-charger.rules"
	install -Dm644 "$srcdir/disable-bq25980.service" "$pkgdir/usr/lib/systemd/system/disable-bq25980.service"
	install -Dm644 "$srcdir/qcam.desktop" "$pkgdir/usr/share/applications/qcam.desktop"
	install -Dm644 "$srcdir/OnePlus8Pro-HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/OnePlus8Pro/HiFi.conf"
	install -Dm644 "$srcdir/OnePlus8Pro.conf" "$pkgdir/usr/share/alsa/ucm2/OnePlus8Pro/OnePlus8Pro.conf"
	install -Dm644 "$srcdir/OnePlus8Pro.conf" "$pkgdir/usr/share/alsa/ucm2/conf.d/OnePlus8Pro/OnePlus8Pro.conf"
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
	ln -s ../../OnePlus8Pro/OnePlus8Pro.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/OnePlus8Pro.conf"
}

