{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnipha device.yaml",
  "description": "One file per device in devices/<id>/device.yaml. Hardware facts and OS support only. No prices, no availability, no market data.",
  "type": "object",
  "required": [
    "codename",
    "name",
    "vendor",
    "upstream_os"
  ],
  "properties": {
    "codename": {
      "type": "string",
      "description": "Device id, equals the folder name, e.g. xiaomi-laurel"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other codenames used by upstream projects or downstream tools"
    },
    "name": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "soc": {
      "type": "string",
      "description": "Platform id used in kernel/packaging, e.g. sm6125"
    },
    "soc_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Marketing name, e.g. Snapdragon 732G"
    },
    "nfc": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "stock_android": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream_os": {
      "type": "object",
      "description": "Support status reported by upstream projects. ut is refreshed by tools/harvest.py, nura is curated by hand.",
      "required": [
        "ut",
        "nura"
      ],
      "properties": {
        "ut": {
          "type": "object",
          "required": [
            "key",
            "listed",
            "source",
            "checked"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "Codename on devices.ubuntu-touch.io"
            },
            "listed": {
              "type": "boolean"
            },
            "supported": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "installer": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "release": {
              "type": [
                "string",
                "null"
              ]
            },
            "progress_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "string"
            },
            "checked": {
              "type": "string"
            }
          }
        },
        "nura": {
          "type": "object",
          "required": [
            "status",
            "image",
            "source",
            "checked"
          ],
          "properties": {
            "status": {
              "enum": [
                "community",
                "generic-image",
                "not-checked",
                "packaged-edge",
                "self-built",
                "testing",
                "unverified"
              ]
            },
            "image": {
              "enum": [
                "generic-exynos9820",
                "generic-msm8953",
                "generic-sdm845",
                "generic-sm7125",
                "generic-sm7150",
                "none",
                "own"
              ]
            },
            "release": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "string"
            },
            "checked": {
              "type": "string"
            }
          }
        }
      }
    },
    "device_repo": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/omnipha/device-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Canonical public device repository. Presence does not imply an official image."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage"],
      "description": "Omnipha project progress, not an installability claim. Missing means research-only; release is independent.",
      "properties": {
        "stage": {"enum": ["research", "bring-up", "field-tested", "retired"]},
        "mission": {"type": "string", "pattern": "^https://github\\.com/omnipha/[a-z0-9-]+/issues/[1-9][0-9]*$"}
      }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Public identities and roles responsible for the device. No host details or secrets.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
            "description": "Public GitHub login"
          },
          "role": {
            "enum": ["hardware-tester", "maintainer", "release-owner"]
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "description": "Omnipha image status, independent of upstream_os. Absence means unreleased and unowned.",
      "required": ["status", "maintenance"],
      "properties": {
        "status": {
          "enum": ["unreleased", "testing", "official"]
        },
        "maintenance": {
          "enum": ["unowned", "maintained"]
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "manifest"],
          "description": "Public immutable image artifact and input/build manifest; required before claiming availability.",
          "properties": {
            "url": {"type": "string", "pattern": "^https://[^/]+/.+$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "manifest": {"type": "string", "pattern": "^https://[^/]+/.+$"}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ci_build", "flashing_rollback", "physical_test"],
          "properties": {
            "ci_build": {
              "type": "string",
              "pattern": "^https://[^/]+/.+$",
              "description": "Link to reproducible CI image build with pinned inputs"
            },
            "flashing_rollback": {
              "type": "string",
              "pattern": "^https://[^/]+/.+$",
              "description": "Link to device-specific flashing and rollback instructions"
            },
            "physical_test": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "tester", "boot", "network", "ssh"],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "tester": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
                },
                "boot": {"const": "works"},
                "network": {"const": "works"},
                "ssh": {"const": "works"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["testing", "official"]}}},
          "then": {"required": ["artifact", "evidence"]},
          "else": {"not": {"anyOf": [{"required": ["artifact"]}, {"required": ["evidence"]}]}}
        },
        {
          "if": {"properties": {"status": {"const": "official"}}},
          "then": {"properties": {"maintenance": {"const": "maintained"}}}
        }
      ]
    },
    "status": {
      "type": "object",
      "description": "Legacy Omnipha hardware claims on our units; public evidence is required for new positive/negative claims.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"enum": ["works", "partial", "untested", "broken"]}
    },
    "status_evidence": {
      "type": "object",
      "description": "Public per-component test record for new claims; absence on legacy statuses is not evidence.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "variant", "url"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "variant": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://[^/]+/.+$"}
        }
      }
    },
    "variants": {
      "type": "array",
      "description": "Sold configurations of this model. Variant = one ram/storage combination.",
      "items": {
        "type": "object",
        "required": [
          "ram_gb",
          "storage_gb"
        ],
        "properties": {
          "ram_gb": {
            "type": [
              "number",
              "null"
            ]
          },
          "storage_gb": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "used_price_eur"
        ]
      },
      {
        "required": [
          "ebay"
        ]
      },
      {
        "required": [
          "price"
        ]
      }
    ]
  }
}
